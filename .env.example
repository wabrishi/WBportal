# Port the app listens on. A PORT set by the host (Hostinger web hosting, Docker, pm2) always wins over
# this file. On Hostinger web hosting do NOT set PORT in hPanel — Hostinger assigns it.
PORT=3000

# First-run setup: open /admin in your browser and create your super admin account there.
# SETUP_KEY protects that page until you've done it (you'll be asked for this key). Use a random string.
SETUP_KEY=
# (Alternative: create the super admin automatically on first start instead of the setup page)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Enables https://yourdomain.com/api/cron?key=CRON_KEY — call it every 5 minutes from a cron job or an
# uptime monitor: it wakes the app if the host stopped it and reconnects dropped WhatsApp numbers.
CRON_KEY=

# MySQL / MariaDB database (recommended; on Hostinger: hPanel → Databases → MySQL Databases).
# When DB_NAME is set, all data and WhatsApp logins are stored in MySQL (tables are created
# automatically) and the JSON files below are no longer used. Existing JSON data found in STORAGE_DIR
# is imported automatically the first time the app starts with an empty database.
# Alternative to the DB_* lines: DATABASE_URL=mysql://user:password@host:3306/database
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Max simultaneous MySQL connections (shared hosting limits these; 5 is plenty)
DB_CONNECTION_LIMIT=5

# Only used without MySQL (and as the source for the one-time import into MySQL):
# where JSON data and WhatsApp logins are stored. Leave empty for automatic:
# on Hostinger web hosting → /home/<user>/domains/<domain>/app-storage (survives redeploys),
# elsewhere → data/ and sessions/ next to server.js.
STORAGE_DIR=

# Reverse proxy in front of the app (for correct visitor IPs). Leave empty for automatic.
# Docker + Traefik: 1
TRUST_PROXY=

# Only used once, when upgrading from the single-company version: the name of the workspace
# your existing data is moved into.
COMPANY_NAME=My Company

# Defaults for every workspace's campaign throttling (each workspace can change these on its Block Risk page)
MIN_DELAY_MS=8000
MAX_DELAY_MS=20000
DAILY_LIMIT_PER_SESSION=500

# Support tickets (apply to all workspaces)
# Open a ticket automatically for every incoming WhatsApp message (true/false)
AUTO_TICKETS=true
# A customer reply within this many days reopens a resolved ticket; after that a new ticket is created
TICKET_REOPEN_DAYS=7
# Sent when a new ticket is opened ({{ticket}}, {{name}} available). Set to "off" to disable.
TICKET_AUTO_REPLY="Thanks for contacting us! Your ticket #{{ticket}} has been created. Our team will reply shortly."
# Sent when an agent marks a ticket resolved. Set to "off" to disable.
TICKET_RESOLVED_MESSAGE="Your ticket #{{ticket}} has been resolved. Reply to this chat if you need more help."

# Plans, prices, trial length, brand name and payment instructions are edited in the /admin panel.
# Each workspace sets its own webhook URL on its Subscription page.

# Development only: allow http://localhost / http://127.0.0.1 webhook URLs (e.g. Lead Manager on :3010).
# Leave unset in production (webhook URLs must then be https://).
# ALLOW_HTTP_WEBHOOKS=true

# ---------- Suite Hub (single sign-on + subscriptions), see DEPLOY.md "Connecting to the Suite Hub" ----------
# local (default): own logins, signup, plans and billing. hub: "Sign in with your account" via the Hub.
AUTH_MODE=local
# HUB_URL=https://accounts.yourdomain.com
# From the Hub: Admin → Apps & SSO → Register app (redirect URI: https://wa.yourdomain.com/auth/hub/callback)
# HUB_CLIENT_ID=
# HUB_CLIENT_SECRET=
# Same value as WA_EVENTS_SECRET in the Hub's env (signs the Hub's events to /api/suite/events)
# SUITE_EVENTS_SECRET=
# This app's public URL, used to build the redirect URI (e.g. https://wa.yourdomain.com, dev: http://localhost:3001)
# APP_URL=

# ---------- Fewer processes on shared hosting (Hostinger counts every thread) ----------
# Set these two in hPanel → Environment variables (they have no effect in this file):
#   UV_THREADPOOL_SIZE=2
#   NODE_OPTIONS=--v8-pool-size=1
# Public URL: copies of the app started for another host name (e.g. www.) only redirect here.
# APP_URL=https://wa.yourdomain.com
# Video thumbnails need an ffmpeg process per video sent; off unless true.
# VIDEO_THUMBNAILS=false
